#!/usr/bin/env bash
set -euo pipefail

# Starts YARG (installed by the YARC launcher) for whichever account runs it,
# with the shared song library and the owner's settings.
#
# YARG keeps everything in ~/.config/unity3d/YARC/YARG/<release|nightly>, per
# user. The
# owner of this launcher (whose home it is installed in) publishes settings
# and profiles to the games disk at each start and exit; the Steam guest,
# which sees nothing of the owner's home, takes them at each start. Scores,
# replays and the song cache stay per user.

yarc_dir=${OMARCHY_YARG_DIR:-/wdblack_4TB/Games/YARC}
songs_dir=${OMARCHY_YARG_SONGS:-$yarc_dir/Songs}
shared_settings=${OMARCHY_YARG_SHARED_SETTINGS:-$yarc_dir/omarchy-shared-settings}
unity_dir=${XDG_CONFIG_HOME:-$HOME/.config}/unity3d/YARC/YARG
# Which YARC install to start: nightly (career mode; builds tagged bNNNN) or
# stable (vX.Y.Z). Falls back to the newest install of any kind.
channel=${OMARCHY_YARG_CHANNEL:-nightly}
shared_items=(settings.json profiles custom)
# Which build: windows (the Windows zip under GE-Proton; plays H.264 song
# videos and recognises the CRKD guitar) or linux (the YARC launcher's
# install).
platform=${OMARCHY_YARG_PLATFORM:-windows}
win_dir=${OMARCHY_YARG_WINDOWS_DIR:-$yarc_dir/omarchy-windows}
steam_root=${STEAM_ROOT:-$HOME/.local/share/Steam}
proton=${OMARCHY_YARG_PROTON:-$steam_root/compatibilitytools.d/GE-Proton11-1/proton}
prefix=${OMARCHY_YARG_PREFIX:-${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-yarg/proton}
win_unity_dir=$prefix/pfx/drive_c/users/steamuser/AppData/LocalLow/YARC/YARG
# OMARCHY_YARG_OWNER: test hook.
launcher_owner=${OMARCHY_YARG_OWNER:-$(stat -c %U -- "${BASH_SOURCE[0]}" 2>/dev/null || true)}

resolve_yarg() {
  if [[ -n ${YARG_BIN:-} ]]; then
    [[ -x $YARG_BIN ]] && printf '%s\n' "$YARG_BIN"
    return
  fi
  # YARC installs: "YARG Installs/<id>/installation/YARG", the release tag in
  # "<id>/tag.txt". The newest of the chosen channel, else the newest of all.
  # Windows builds (install-windows.sh): "omarchy-windows/<tag>/YARG.exe".
  local bin tag pattern any='' pick='' best=-1 any_best=-1 t bins
  case $channel in
    stable) pattern='^v[0-9]' ;;
    *) pattern='^b[0-9]' ;;
  esac
  if [[ $platform == windows ]]; then
    bins=("$win_dir"/*/YARG.exe)
  else
    bins=("$yarc_dir/YARG Installs"/*/installation/YARG)
  fi
  for bin in "${bins[@]}"; do
    [[ -f $bin ]] || continue
    [[ $platform == windows || -x $bin ]] || continue
    t=$(stat -c %Y -- "$bin")
    tag=$(head -c 64 -- "$(tag_file "$bin")" 2>/dev/null || true)
    ((t > any_best)) && { any_best=$t; any=$bin; }
    [[ $tag =~ $pattern ]] && ((t > best)) && { best=$t; pick=$bin; }
  done
  pick=${pick:-$any}
  [[ -n $pick ]] && printf '%s\n' "$pick"
}

tag_file() { # yarg binary
  case $1 in
    */YARG.exe) printf '%s\n' "${1%/YARG.exe}/tag.txt" ;;
    *) printf '%s\n' "${1%/installation/YARG}/tag.txt" ;;
  esac
}

# Nightly and stable keep separate settings folders; the Windows build keeps
# them inside the Wine prefix.
channel_dir() { # yarg binary
  local tag
  tag=$(head -c 64 -- "$(tag_file "$1")" 2>/dev/null || true)
  [[ $tag =~ ^b[0-9] ]] && echo nightly || echo release
}
config_for() { # yarg binary
  if [[ $1 == */YARG.exe ]]; then
    printf '%s\n' "$win_unity_dir/$(channel_dir "$1")"
  else
    printf '%s\n' "$unity_dir/$(channel_dir "$1")"
  fi
}

# Z:\ is the whole Linux filesystem in Wine.
winpath() { printf 'Z:%s\n' "${1//\//\\}"; }

# Copies only; never deletes, so a wrong path cannot cost anything.
copy_settings() { # from to
  local item
  mkdir -p -- "$2" || return 1
  for item in "${shared_items[@]}"; do
    [[ -e $1/$item ]] || continue
    rsync -rt --chmod=Du=rwx,Dgo=rx,Fu=rw,Fgo=r -- "$1/$item" "$2/" || return 1
  done
}

publish_settings() {
  [[ $(id -un) == "$launcher_owner" && -d $yarc_dir ]] || return 0
  copy_settings "$config_dir" "$shared_settings" ||
    echo "omarchy-yarg: could not share settings in $shared_settings" >&2
}

take_shared_settings() {
  [[ -n $launcher_owner && $(id -un) != "$launcher_owner" && -f $shared_settings/settings.json ]] || return 0
  copy_settings "$shared_settings" "$config_dir" ||
    echo "omarchy-yarg: could not copy shared settings from $shared_settings" >&2
}

# The song library is listed even before anyone opened YARG's settings.
ensure_song_folder() {
  [[ -d $songs_dir ]] || return 0
  local folder=$songs_dir
  [[ $platform == windows ]] && folder=$(winpath "$songs_dir")
  mkdir -p -- "$config_dir"
  python3 -I - "$config_dir/settings.json" "$folder" <<'EOF' ||
import json, os, sys
path, songs = sys.argv[1], sys.argv[2]
try:
    with open(path) as f:
        data = json.load(f)
except FileNotFoundError:
    data = {}
folders = data.setdefault("SongFolders", [])
if songs not in folders:
    folders.append(songs)
    tmp = path + ".omarchy-tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, path)
EOF
    echo "omarchy-yarg: could not add $songs_dir to $config_dir/settings.json" >&2
}

if [[ ${1:-} == --print-yarg ]]; then
  resolve_yarg
  exit
fi

yarg=$(resolve_yarg) || true
if [[ -z $yarg ]]; then
  if [[ $platform == windows ]]; then
    echo "omarchy-yarg: no Windows YARG under $win_dir (components/yarg/install-windows.sh), or OMARCHY_YARG_PLATFORM=linux" >&2
  else
    echo "omarchy-yarg: no YARG install under $yarc_dir/YARG Installs (install it with the YARC launcher, or set YARG_BIN)" >&2
  fi
  exit 1
fi

# Window backend. Unity picks X11 (XWayland) by default, and XWayland reports
# the HDMI monitor as the primary display: fullscreen on the ultrawide, YARG
# then maps the mouse against the wrong monitor and many menu buttons only
# respond after the window moves between monitors. The native Wayland backend
# (built into this Unity player) sees the real outputs. Vulkan on Wayland dies
# at start with the NVIDIA driver ("Surface already has a fifo"), so Wayland
# runs with OpenGL. OMARCHY_YARG_BACKEND=x11 goes back to XWayland; -force-x11
# / -force-wayland on the command line win.
#
# On Wayland YARG opens on the display Unity saved (UnitySelectMonitor), not
# on the focused one, so pass -monitor for OMARCHY_YARG_MONITOR (a Hyprland
# output name such as DP-1); by default the largest monitor. Unity lists the
# outputs in Hyprland's id order and -monitor counts from 1.
pick_monitor() { # [wine]: Wine's numbering, printed as "index width height"
  command -v hyprctl >/dev/null && command -v jq >/dev/null || return 0
  hyprctl -j monitors 2>/dev/null | jq -r --arg name "${OMARCHY_YARG_MONITOR:-}" --arg want "${1:-}" '
    ((if $want == "wine" then sort_by(.x, .y) else sort_by(.id) end) | to_entries) as $all
    | (if $name != "" then [$all[] | select(.value.name == $name)]
       else [$all | max_by(.value.width * .value.height)] end)
    | first | select(. != null)
    | if $want == "wine" then "\(.key + 1) \(.value.width) \(.value.height)" else .key + 1 end' 2>/dev/null || true
}

backend_args=()
[[ $platform == windows ]] && OMARCHY_YARG_BACKEND=none
case ${OMARCHY_YARG_BACKEND:-auto} in
  none) ;;
  wayland) backend_args=(-force-wayland -force-glcore) ;;
  x11) ;;
  *) [[ -n ${WAYLAND_DISPLAY:-} ]] && backend_args=(-force-wayland -force-glcore) ;;
esac
# YARG looks for YARC downloads (Venues/, Setlists/ such as the official
# setlist) only under -download-location, which the YARC launcher passes; the
# folder it would use otherwise is empty.
location_args=()
if [[ -d $yarc_dir ]]; then
  location_args=(-download-location "$yarc_dir")
  [[ $platform == windows ]] && location_args=(-download-location "$(winpath "$yarc_dir")")
fi
user_monitor=0
for arg in "$@"; do
  case $arg in
    -force-x11|-force-wayland) backend_args=() ;;
    -monitor) user_monitor=1 ;;
    -download-location) location_args=() ;;
  esac
done
if ((${#backend_args[@]} && !user_monitor)); then
  monitor=$(pick_monitor)
  [[ $monitor =~ ^[0-9]+$ ]] && backend_args+=(-monitor "$monitor")
fi

config_dir=${OMARCHY_YARG_CONFIG:-$(config_for "$yarg")}

# First nightly start for the owner: begin from the stable settings (song
# folders, players and bindings, presets).
if [[ -z ${OMARCHY_YARG_CONFIG:-} && $config_dir == "$unity_dir/nightly" &&
      ! -f $config_dir/settings.json && -f $unity_dir/release/settings.json &&
      $(id -un) == "$launcher_owner" ]]; then
  copy_settings "$unity_dir/release" "$config_dir" ||
    echo "omarchy-yarg: could not copy stable settings to $config_dir" >&2
fi

# First start of the Windows build for the owner: begin from the Linux
# settings of the same channel (song folders as Z:\ paths, players and
# bindings, presets). Items already there are kept, so bindings made in the
# Windows build stay.
seed_windows_config() {
  local from item
  from=$unity_dir/$(basename -- "$config_dir")
  [[ -f $from/settings.json ]] || from=$unity_dir/release
  [[ -f $from/settings.json ]] || return 0
  mkdir -p -- "$config_dir" || return 1
  for item in "${shared_items[@]}"; do
    [[ -e $from/$item && ! -e $config_dir/$item ]] || continue
    cp -a -- "$from/$item" "$config_dir/" || return 1
  done
  python3 -I -c '
import json, os, sys
path = sys.argv[1]
data = json.load(open(path))
folders = [("Z:" + f.replace("/", "\\")) if f.startswith("/") else f
           for f in data.get("SongFolders", [])]
data["SongFolders"] = list(dict.fromkeys(folders))
json.dump(data, open(path + ".omarchy-tmp", "w"), indent=2)
os.replace(path + ".omarchy-tmp", path)
' "$config_dir/settings.json"
}
if [[ $platform == windows && -z ${OMARCHY_YARG_CONFIG:-} && ! -f $config_dir/settings.json &&
      $(id -un) == "$launcher_owner" ]]; then
  seed_windows_config || echo "omarchy-yarg: could not copy Linux settings to $config_dir" >&2
fi

take_shared_settings
ensure_song_folder
publish_settings

# Song videos. YARG plays them through libVLC 4 when its libVLCUnityPlugin.so
# finds libvlc.so.12, else through Unity's VideoPlayer, which on Linux decodes
# VP8 WebM only (components/yarg/webm-videos.py makes bg.webm copies). A
# private VLC 4 can be installed (install-vlc4.sh), but on this NVIDIA setup
# the plugin decodes and then shows black on every path tried (Wayland EGL on
# the NVIDIA and Intel GBM nodes, X11 GLX, X11 Vulkan; 2026-11-20), and once
# VLC loads YARG uses it for every video. So it is opt-in:
# OMARCHY_YARG_VLC_ENABLE=1. YARG points VLC_PLUGIN_PATH at
# YARG_Data/Plugins/vlc/plugins; the link there is made when enabled and
# removed when not (Unity loads everything under Plugins/).
vlc_dir=${OMARCHY_YARG_VLC:-${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-yarg/vlc4}
plugin_link="$(dirname -- "$yarg")/YARG_Data/Plugins/vlc"
if [[ ${OMARCHY_YARG_VLC_ENABLE:-0} == 1 && -f $vlc_dir/libvlc.so.12 && -d $vlc_dir/vlc/plugins ]]; then
  if [[ -d ${plugin_link%/vlc} && ( -L $plugin_link || ! -e $plugin_link ) ]]; then
    ln -sfn -- "$vlc_dir/vlc" "$plugin_link" ||
      echo "omarchy-yarg: could not link $plugin_link to $vlc_dir/vlc" >&2
  fi
  export LD_LIBRARY_PATH="$vlc_dir:$vlc_dir/vlc${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  [[ -n ${OMARCHY_YARG_VLC_DRM_DEVICE:-} ]] && export VLC_UNITY_DRM_DEVICE="$OMARCHY_YARG_VLC_DRM_DEVICE"
elif [[ -L $plugin_link && $(readlink -- "$plugin_link") == "$vlc_dir/vlc" ]]; then
  rm -f -- "$plugin_link"
fi

# Steam's overlay is in LD_PRELOAD and reaches every program YARG starts. The
# "Open ... folder" buttons run xdg-open, which runs /usr/bin/file; file's
# seccomp sandbox kills it when the overlay calls getuid at exit, so xdg-open
# fails and nothing opens. An xdg-open first on PATH drops the preload.
open_shim_dir() {
  local real dir
  real=$(command -v xdg-open) || return 0
  dir=${XDG_RUNTIME_DIR:-/tmp}/omarchy-yarg-bin
  mkdir -p -- "$dir" || return 0
  printf '#!/bin/sh\nunset LD_PRELOAD\nexec %q "$@"\n' "$real" >"$dir/xdg-open" &&
    chmod 755 "$dir/xdg-open" && printf '%s\n' "$dir"
}
if shim=$(open_shim_dir) && [[ -n $shim ]]; then
  export PATH="$shim:$PATH"
fi

status=0
if [[ $platform == windows ]]; then
  # The Windows build under GE-Proton, in a prefix of its own per account.
  # Under XWayland it has the same menu-click problem as above, so it runs on
  # Wine's Wayland driver (OMARCHY_YARG_WAYLAND=0 goes back).
  #
  # Unity keeps the monitor and resolution it last used (registry
  # Screenmanager / UnitySelectMonitor) and does not follow a move to another
  # monitor, so a size saved on the HDMI screen left a 1920x1080 window on the
  # ultrawide. Pass the chosen monitor (largest, or OMARCHY_YARG_MONITOR) with
  # its size, fullscreen. Wine numbers outputs by position (left to right),
  # not by Hyprland id. -monitor or -screen-* on the command line win.
  screen_args=()
  if [[ $user_monitor == 0 && " $* " != *" -screen-width "* ]] && read -r idx w h < <(pick_monitor wine) &&
     [[ $idx =~ ^[0-9]+$ ]]; then
    screen_args=(-monitor "$idx" -screen-width "$w" -screen-height "$h" -screen-fullscreen 1)
  fi
  if [[ ! -x $proton ]]; then
    echo "omarchy-yarg: no Proton at $proton (set OMARCHY_YARG_PROTON)" >&2
    exit 1
  fi
  mkdir -p -- "$prefix"
  export STEAM_COMPAT_DATA_PATH=$prefix
  export STEAM_COMPAT_CLIENT_INSTALL_PATH=${STEAM_COMPAT_CLIENT_INSTALL_PATH:-$steam_root}
  export SteamAppId=${SteamAppId:-0} SteamGameId=${SteamGameId:-0}
  if [[ -n ${WAYLAND_DISPLAY:-} && ${OMARCHY_YARG_WAYLAND:-1} == 1 ]]; then
    export PROTON_ENABLE_WAYLAND=1
  fi
  (cd -- "$(dirname -- "$yarg")" && "$proton" run ./YARG.exe ${screen_args[@]+"${screen_args[@]}"} ${location_args[@]+"${location_args[@]}"} "$@") || status=$?
  publish_settings
  exit "$status"
fi
(cd -- "$(dirname -- "$yarg")" && "$yarg" ${backend_args[@]+"${backend_args[@]}"} ${location_args[@]+"${location_args[@]}"} "$@") || status=$?
publish_settings
exit "$status"
