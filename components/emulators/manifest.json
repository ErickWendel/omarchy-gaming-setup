{
  "version": 1,
  "comment": "Placeholders: {emulation} is <GExtended mount>/Emulation, resolved by UUID; {home} is $HOME; {icons} is EmuDeck's icon directory; a missing icon file falls back to applications-games. legacy_files are EmuDeck entries this manifest replaces when they are malformed; duplicate_files are valid entries for the same emulator that are always replaced.",
  "emulators": [
    {
      "id": "azahar",
      "name": "Azahar",
      "generic_name": "Nintendo 3DS Emulator",
      "exec": "{emulation}/tools/launchers/azahar.sh",
      "icon": "{icons}/Azahar.svg",
      "categories": "Game;Emulator;",
      "keywords": "3DS;Nintendo;",
      "legacy_files": ["Azahar.desktop"]
    },
    {
      "id": "duckstation",
      "name": "DuckStation",
      "generic_name": "PlayStation Emulator",
      "exec": "{emulation}/tools/launchers/duckstation.sh",
