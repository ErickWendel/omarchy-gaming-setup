#!/usr/bin/env bash
set -euo pipefail

# Steam opens Sony HIDAPI devices before non-Steam shortcuts start. PCSX2 must
# use SDL's evdev path so both physical pads remain independently available.
export APPIMAGE_EXTRACT_AND_RUN=1
# The AppImage extracts to $TMPDIR/appimage_extracted_<hash>, a name that is
# the same for every user. Under the shared /tmp, whoever launches first (the
# guest account, for example) owns that 0700 folder and every other user's
# launch fails with "mkdir_p error: Permission denied". Extract per user.
TMPDIR="${XDG_RUNTIME_DIR:-$HOME/.cache}/omarchy-pcsx2-tmp"
mkdir -p -m 700 "$TMPDIR"
export TMPDIR
export SDL_JOYSTICK_HIDAPI_PS4=0
export SDL_JOYSTICK_HIDAPI_PS5=0
# Steam tracks the focused game through X11 only. A native Wayland PCSX2
# window is invisible to it, so Steam keeps routing controller input (PS
# button included) to the Big Picture window behind the game.
export QT_QPA_PLATFORM=xcb

# --omarchy-diagnose prints the diagnostics and exits. OMARCHY_PCSX2_DIAGNOSE=1
# (for example as a Steam launch option: OMARCHY_PCSX2_DIAGNOSE=1 %command%)
# appends them to a bounded log and then starts PCSX2, so a Steam launch can
# be compared with a direct one. Neither logs input events.
diagnose=false
if [[ ${1:-} == --omarchy-diagnose ]]; then
  diagnose=true
  shift
fi
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-gaming-setup"
diagnose_log="$state_dir/pcsx2-launch.log"

resolve_pcsx2() {
  local candidate
  if [[ -n ${PCSX2_APPIMAGE:-} ]]; then
    [[ -x $PCSX2_APPIMAGE ]] || return 1
    printf '%s\n' "$PCSX2_APPIMAGE"
    return
  fi

  for candidate in \
    "$HOME/Applications/pcsx2-Qt.AppImage" \
    "$HOME/Applications/PCSX2.AppImage"; do
    if [[ -x $candidate ]]; then
      printf '%s\n' "$candidate"
      return
    fi
  done

  find "$HOME/Applications" -maxdepth 1 -type f -iname 'pcsx2*.AppImage' \
    -perm -u+x -print 2>/dev/null | sort -V | tail -n 1
}

pcsx2=$(resolve_pcsx2)
if [[ -z $pcsx2 ]]; then
  echo "PCSX2 AppImage is missing or not executable under $HOME/Applications" >&2
  exit 127
fi

args=()
for arg in "$@"; do
  # Preserve compatibility with older Steam ROM Manager entries that wrapped
  # the complete ROM argument in literal single quotes.
  arg=${arg#\'}
  arg=${arg%\'}
  args+=("$arg")
done

launch_origin() {
  if [[ -n ${SteamGameId:-${SteamAppId:-}} ]] || grep -q '^Name:\s*steam$' "/proc/$PPID/status" 2>/dev/null; then
    echo steam
  else
    echo direct
  fi
}

# One line per joystick: name, vendor:product, event node and whether this
# user can read it (the session ACL that steam-devices/logind grant).
list_controllers() {
  awk -v RS= '/Handlers=[^\n]*js[0-9]/ {
    name = $0; sub(/.*N: Name="/, "", name); sub(/".*/, "", name)
    vendor = $0; sub(/.*Vendor=/, "", vendor); sub(/ .*/, "", vendor)
    product = $0; sub(/.*Product=/, "", product); sub(/ .*/, "", product)
    event = $0; sub(/.*Handlers=[^\n]*event/, "event", event); sub(/[ \n].*/, "", event)
    print name "\t" vendor ":" product "\t" event
  }' /proc/bus/input/devices 2>/dev/null |
    while IFS=$'\t' read -r name id event; do
      readable=no
      [[ -r /dev/input/$event ]] && readable=yes
      printf 'controller=%s [%s] /dev/input/%s readable=%s\n' "$name" "$id" "$event" "$readable"
    done
}

print_diagnostics() {
  printf 'time=%s\n' "$(date -Is)"
  printf 'origin=%s\n' "$(launch_origin)"
  printf 'launcher=%s\n' "$0"
  printf 'pcsx2=%s\n' "$pcsx2"
  printf 'config_dir=%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/PCSX2"
  printf 'SDL_JOYSTICK_HIDAPI_PS4=%s\n' "$SDL_JOYSTICK_HIDAPI_PS4"
  printf 'SDL_JOYSTICK_HIDAPI_PS5=%s\n' "$SDL_JOYSTICK_HIDAPI_PS5"
  printf 'SteamGameId=%s\n' "${SteamGameId:-${SteamAppId:-}}"
  # Steam sets this when Steam Input owns the pads: SDL then hides the
  # physical controllers and PCSX2 sees only Steam's virtual one.
  printf 'SDL_GAMECONTROLLER_IGNORE_DEVICES=%s\n' "${SDL_GAMECONTROLLER_IGNORE_DEVICES:-}"
  if [[ -n ${SDL_GAMECONTROLLER_IGNORE_DEVICES:-} ]]; then
    echo 'steam_input=active (disable Steam Input for this shortcut)'
  else
    echo 'steam_input=off'
  fi
  list_controllers | grep . || echo 'controller=none'
}

if $diagnose; then
  print_diagnostics
  exit 0
fi
if [[ ${OMARCHY_PCSX2_DIAGNOSE:-0} == 1 ]] && mkdir -p "$state_dir" 2>/dev/null; then
  { print_diagnostics; echo; } >>"$diagnose_log"
  # Keep the log bounded.
  tail -n 500 "$diagnose_log" >"$diagnose_log.tmp" && mv "$diagnose_log.tmp" "$diagnose_log"
fi

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/PCSX2"
# Settings both accounts use: the owner of this launcher (whose home it is
# installed in) copies them here at each start and exit; the Steam guest,
# which sees nothing of the owner's home, takes them at each start. Saves,
# memory cards and BIOS already live on the shared Emulation disk.
shared_settings=${OMARCHY_PCSX2_SHARED_SETTINGS:-/wdblack_4TB/Emulation/storage/pcsx2/omarchy-shared-settings}
shared_items=(inis/PCSX2.ini gamesettings patches cheats inputprofiles)
# OMARCHY_PCSX2_OWNER: test hook.
launcher_owner=${OMARCHY_PCSX2_OWNER:-$(stat -c %U -- "${BASH_SOURCE[0]}" 2>/dev/null || true)}

# Copies only; never deletes, so a wrong path cannot cost anything.
copy_settings() { # from to
  local item
  for item in "${shared_items[@]}"; do
    [[ -e $1/$item ]] || continue
    mkdir -p -- "$(dirname -- "$2/$item")" &&
      rsync -rt --chmod=Du=rwx,Dgo=rx,Fu=rw,Fgo=r -- "$1/$item" "$(dirname -- "$2/$item")/" || return 1
  done
}
publish_settings() {
  [[ $(id -un) == "$launcher_owner" && -d ${shared_settings%/*} ]] || return 0
  copy_settings "$config_dir" "$shared_settings" ||
    echo "omarchy-pcsx2: could not share settings in $shared_settings" >&2
}
take_shared_settings() {
  [[ -n $launcher_owner && $(id -un) != "$launcher_owner" && -f $shared_settings/inis/PCSX2.ini ]] || return 0
  copy_settings "$shared_settings" "$config_dir" ||
    { echo "omarchy-pcsx2: could not copy shared settings from $shared_settings" >&2; return 0; }
  # The AppImage is the owner's and read-only here: no update prompts.
  local ini=$config_dir/inis/PCSX2.ini
  if grep -q '^\[AutoUpdater\]' "$ini"; then
    sed -i '/^\[AutoUpdater\]/,/^\[/{/^CheckAtStartup *=/d}; /^\[AutoUpdater\]/a CheckAtStartup = false' "$ini"
  else
    printf '\n[AutoUpdater]\nCheckAtStartup = false\n' >>"$ini"
  fi
}

# Logitech wheels run at 900 degrees; PS2 games (Driving Force era) map the
# full axis to the car's lock, so steering felt far too slow. Use a short
# range while PCSX2 runs and give the wheel its previous range back after.
wheel_range=${OMARCHY_PCSX2_WHEEL_RANGE-360}
wheel_restore=()
set_wheel_range() {
  local attr
  [[ $wheel_range =~ ^[0-9]+$ ]] || return 0
  for attr in /sys/bus/hid/devices/*:046D:*/range; do
    [[ -w $attr ]] || continue
    wheel_restore+=("$attr=$(<"$attr")")
    echo "$wheel_range" >"$attr" 2>/dev/null || true
  done
}
restore_wheel_range() {
  local entry
  for entry in "${wheel_restore[@]}"; do
    echo "${entry#*=}" >"${entry%%=*}" 2>/dev/null || true
  done
}

take_shared_settings
publish_settings
set_wheel_range
trap 'kill -TERM "$child" 2>/dev/null' TERM INT HUP
"$pcsx2" "${args[@]}" &
child=$!
status=0
# wait returns early when a trapped signal arrives; wait again for the exit.
wait "$child" || status=$?
while kill -0 "$child" 2>/dev/null; do wait "$child" || status=$?; done
restore_wheel_range
publish_settings
exit "$status"

