# Copy to config/machine.env for local overrides. This file is shell syntax.
# Games disk: Steam library (SteamLibrary), PC games (Games) and EmuDeck's
# Emulation folder, one btrfs subvolume each.
GAMES_DISK_UUID="e2eef595-b785-4724-a4e4-f00f88806f12"
GAMES_DISK_MOUNT="/wdblack_4TB"
GAMES_DIR="$GAMES_DISK_MOUNT/Games"
STEAM_LIBRARY="$GAMES_DISK_MOUNT/SteamLibrary"
# Old USB games disk, now empty of games; scripts/storage.sh still checks it.
GEXTENDED_UUID="1bae75c4-2c80-49ca-b1c0-7d5a0e819e95"
GEXTENDED_LABEL="GExtended"
GEXTENDED_MOUNT="/run/media/${USER}/GExtended"
OPENRGB_PROFILE="static-green"
DELTA_DRIVER_REPOSITORY="https://github.com/ErickWendel/delta-cw360lcd-linux-driver.git"
STEAM_HELPER_REPOSITORY="https://github.com/ErickWendel/ps5-steam-big-picture.git"
# Published helper commit to install; it must exist in the local helper checkout.
STEAM_HELPER_REF="b2fbc22a27ac4e9f6aaeaa41c02093603fae8982"

# Steam account folder under ~/.local/share/Steam/userdata, needed only when
# more than one Steam user has signed in on this machine.
# STEAM_USER_ID="12345678"
