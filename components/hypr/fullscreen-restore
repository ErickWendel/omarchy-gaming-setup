#!/usr/bin/env python3
"""Give fullscreen back to the window that had it before.

Hyprland hands fullscreen to a window opened over a fullscreen one (Omarchy's
misc.on_focus_under_fullscreen = 1), e.g. a game launched from a fullscreen
launcher. When that window closes, nothing gets fullscreen back:
exit_window_retains_fullscreen gives it to whichever window is next in the
focus history, not the one that lost it.

This watcher keeps, per workspace, the windows that went fullscreen in order.
When a fullscreen window closes, the most recent earlier one still open is
focused and made fullscreen again. Windows that leave fullscreen on their own
(Super+F) are forgotten. A launcher that closes its window while the game runs
(Content Manager) is matched again by class and title for a few seconds.

A window whose process is still running was hidden, not closed: Content
Manager hides to the tray when a race starts, sometimes before the race window
exists. Fullscreen is then not handed to an older window (Big Picture), which
would cover the race window with black; the hidden window keeps its place.

A Proton launcher that closes once its game starts (FIFA Mod Manager) is not
the end of the app: while a program of the same Steam app still runs, its next
window gets fullscreen instead of Big Picture, which would otherwise open on
top of the game.
"""
import json
import os
import socket
import subprocess
import sys
import threading
import time

HANDOFF_SETTLE = 0.4  # seconds between a window losing fullscreen and the check for a handoff
REAPPEAR_WAIT = 4.0   # seconds to wait for a launcher that recreates its window
EXIT_WAIT = 10.0      # seconds to wait for a closed window's process to exit
APP_WINDOW_WAIT = 30.0  # seconds a still-running Proton app gets to show its next window
STACK_LIMIT = 16
MODES = {1: "maximized", 2: "fullscreen"}

lock = threading.Lock()
stacks = {}  # workspace id -> [entry]; entry = {addr, cls, title, mode}
known = {}   # address -> last seen client (with fullscreen state)
env = dict(os.environ)


def log(msg):
    print(msg, file=sys.stderr, flush=True)


def connect():
    """Connect to the running Hyprland's event socket.

    The service environment can hold the signature of an earlier Hyprland
    instance whose socket is gone, so try it first and fall back to the
    newest instance that accepts a connection.
    """
    base = os.path.join(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), "hypr")
    dirs = [os.path.join(base, d) for d in os.listdir(base)] if os.path.isdir(base) else []
    dirs.sort(key=os.path.getmtime, reverse=True)
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if sig:
        dirs.insert(0, os.path.join(base, sig))
    for d in dirs:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            sock.connect(os.path.join(d, ".socket2.sock"))
        except OSError:
            sock.close()
            continue
        env["HYPRLAND_INSTANCE_SIGNATURE"] = os.path.basename(d)
        log(f"watching {d}")
        return sock
    sys.exit("No running Hyprland instance")


def hyprctl(*args):
    return subprocess.run(["hyprctl", *args], env=env, capture_output=True, text=True).stdout


def clients():
    try:
        return {c["address"]: c for c in json.loads(hyprctl("clients", "-j")) if c.get("mapped", True)}
    except (json.JSONDecodeError, KeyError):
        return {}


def dispatch(lua):
    hyprctl("eval", f"hl.dispatch({lua})")


def forget(addr):
    for stack in stacks.values():
        stack[:] = [e for e in stack if e["addr"] != addr]


def has_fullscreen(now, ws):
    return any(c["fullscreen"] and c["workspace"]["id"] == ws for c in now.values())


def restore_target(stack, now):
    """The window to give fullscreen back to, or None.

    Only the previous window (top of the stack) may be matched by class and
    title, so a stale entry cannot pick an unrelated window with the same
    title.
    """
    for i, entry in enumerate(reversed(stack)):
        if entry["addr"] in now:
            return now[entry["addr"]], entry
        if i == 0:
            match = next((c for c in now.values()
                          if c["class"] == entry["cls"] and c["title"] == entry["title"]), None)
            if match:
                return match, entry
    return None


def refresh(now):
    """Record fullscreen changes since the last snapshot. Call with lock held."""
    for addr, c in now.items():
        was = known.get(addr, {}).get("fullscreen", 0)
        if c["fullscreen"] and not was:
            forget(addr)
            stack = stacks.setdefault(c["workspace"]["id"], [])
            stack.append({"addr": addr, "cls": c["class"], "title": c["title"], "mode": c["fullscreen"]})
            del stack[:-STACK_LIMIT]
        elif was and not c["fullscreen"]:
            threading.Timer(HANDOFF_SETTLE, check_handoff, (addr,)).start()
    known.clear()
    known.update(now)


def check_handoff(addr):
    """A window left fullscreen: keep it if another window took over, else forget it."""
    with lock:
        now = clients()
        c = now.get(addr)
        if c and not c["fullscreen"] and not has_fullscreen(now, c["workspace"]["id"]):
            forget(addr)


def process_alive(pid):
    """True while pid runs; a zombie has exited."""
    try:
        with open(f"/proc/{pid}/stat") as f:
            return f.read().rpartition(")")[2].split()[0] != "Z"
    except (OSError, IndexError):
        return False


def steam_appid(cls):
    """The Steam app id in a Proton window class (steam_app_<id>), or None."""
    appid = cls.removeprefix("steam_app_")
    return appid if appid != cls and appid.isdigit() else None


def app_running(appid, exclude_pid):
    """True while a Windows program of Steam app appid runs, other than exclude_pid.

    Proton's own helpers (C:\\windows\\...: services.exe, explorer.exe, steam.exe)
    and Linux processes such as wineserver and the reaper do not count: they
    linger after the game exits.
    """
    tag = f"SteamAppId={appid}".encode()
    for entry in os.scandir("/proc"):
        if not entry.name.isdigit() or int(entry.name) == exclude_pid:
            continue
        try:
            with open(f"/proc/{entry.name}/environ", "rb") as f:
                if tag not in f.read().split(b"\0"):
                    continue
            with open(f"/proc/{entry.name}/cmdline", "rb") as f:
                exe = f.read().split(b"\0")[0].decode(errors="replace").lower()
        except OSError:
            continue
        if exe.endswith(".exe") and not exe.startswith("c:\\windows\\") and process_alive(entry.name):
            return True
    return False


def app_window(now, cls, closed_addr):
    """Another main window of the closed window's class: tiled or fullscreen, not a popup."""
    return next((c for c in now.values() if c["class"] == cls and c["address"] != closed_addr
                 and (c["fullscreen"] or not c.get("floating"))), None)


def restore(closed_addr, pid, ws, cls=""):
    """Give fullscreen back once the closed window's process exits.

    While the process runs, the window may only be hidden (a launcher in the
    tray); then only that window coming back may take fullscreen.

    A Proton launcher that closes after starting its game (FIFA Mod Manager
    -closeAfterLaunch) shares the game's steam_app_<id> class. While that app
    still runs, its next window gets fullscreen instead of an older window
    (Big Picture), which would open on top of the game.
    """
    exit_deadline = time.monotonic() + EXIT_WAIT
    app_deadline = time.monotonic() + APP_WINDOW_WAIT
    deadline = None  # REAPPEAR_WAIT from when the process exited
    appid = steam_appid(cls)
    while True:
        with lock:
            now = clients()
            alive = pid > 0 and process_alive(pid)
            if not alive:
                forget(closed_addr)
            if has_fullscreen(now, ws):
                return  # something already took fullscreen
            if appid and time.monotonic() < app_deadline and app_running(appid, pid):
                c = app_window(now, cls, closed_addr)
                if c:
                    addr = c["address"]
                    log(f"giving fullscreen to {c['class']} {c['title']!r} after {closed_addr} closed")
                    dispatch(f'hl.dsp.focus({{ window = "address:{addr}" }})')
                    dispatch(f'hl.dsp.window.fullscreen({{ mode = "fullscreen", '
                             f'action = "set", window = "address:{addr}" }})')
                    return
                time.sleep(0.2)
                continue  # the app is still starting its window
            stack = stacks.get(ws, [])
            if alive:
                stack = [e for e in stack if e["addr"] == closed_addr]
            target = restore_target(stack, now)
            if target:
                c, entry = target
                addr = c["address"]
                log(f"restoring fullscreen to {c['class']} {c['title']!r} after {closed_addr} closed")
                dispatch(f'hl.dsp.focus({{ window = "address:{addr}" }})')
                dispatch(f'hl.dsp.window.fullscreen({{ mode = "{MODES.get(entry["mode"], "fullscreen")}", '
                         f'action = "set", window = "address:{addr}" }})')
                return
        if alive:
            if time.monotonic() >= exit_deadline:
                log(f"{closed_addr} was hidden, not closed; leaving fullscreen alone")
                return
        else:
            deadline = deadline or time.monotonic() + REAPPEAR_WAIT
            if time.monotonic() >= deadline:
                break
        time.sleep(0.2)
    log(f"no earlier fullscreen window came back after {closed_addr} closed")


def on_close(addr):
    with lock:
        c = known.pop(addr, None)
        if not c or not c["fullscreen"]:
            return
        ws = c["workspace"]["id"]
    threading.Thread(target=restore, args=(addr, c.get("pid", -1), ws, c["class"]), daemon=True).start()


def main():
    sock = connect()
    with lock:
        refresh(clients())
    buf = b""
    while True:
        data = sock.recv(4096)
        if not data:
            sys.exit("Hyprland event socket closed")
        buf += data
        *lines, buf = buf.split(b"\n")
        for line in lines:
            event, _, payload = line.decode(errors="replace").partition(">>")
            if event == "closewindow":
                on_close("0x" + payload)
            elif event in ("fullscreen", "openwindow", "movewindowv2"):
                with lock:
                    refresh(clients())


if __name__ == "__main__":
    main()
